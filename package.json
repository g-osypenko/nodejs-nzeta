{
  "name": "nodejs-nzeta",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=source src/index.ts",
    "build": "npm run build -w @lch/auth-core && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format:write": "prettier --write .",
    "smoke": "tsx --conditions=source src/smoke.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck",
    "prepare": "husky",
    "smoke:db": "tsx --conditions=source src/smoke.ts --db",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait db && npm run db:migrate",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:all": "npm run build && vitest run",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "test:mutation": "stryker run",
    "db:seed": "tsx --conditions=source src/seed.ts",
    "web:install": "npm ci --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:typecheck": "npm run typecheck --prefix web",
    "perf:load": "tsx --conditions=source scripts/perf/load.ts",
    "perf:down": "docker compose -f perf/compose.yml down -v",
    "perf:profile": "tsx --conditions=source scripts/perf/profile.ts",
    "perf:explain": "tsx --conditions=source scripts/perf/explain.ts",
    "perf:lighthouse": "tsx --conditions=source scripts/perf/lighthouse.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "10.1.10",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.7",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "^4.6.7",
    "@lch/auth-core": "0.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "^22.20.3",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.7",
    "testcontainers": "12.2.1",
    "tsx": "^4.23.13",
    "typescript": "~5.7.3",
    "vitest": "4.1.12"
  }
}

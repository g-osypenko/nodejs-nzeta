# Copy to .env (gitignored). Values below match docker-compose.yml.
DATA_SOURCE=postgres
DATABASE_URL=postgres://lch:lch_dev_password@127.0.0.1:55432/lch_lab2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000

WEBHOOK_SECRET=change-me-webhook-secret-0001
ADMIN_EMAIL=admin@lch.local
ADMIN_PASSWORD=change-me-admin-password

PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info
SESSION_TTL_HOURS=24
DEBUG_HEADERS=false

# Same-origin frontend (ADR 0008): path to web/dist; empty = API only
# WEB_DIST_DIR=web/dist

# Admission control of password hashing (spec §9, ADR 0010)
AUTH_HASH_CONCURRENCY=1
AUTH_HASH_QUEUE=8

# Passwordless sign-in and cookie session (ADR 0011)
# Public origin of the site: links in sign-in letters + the Origin the CSRF guard accepts.
# Empty = the request's own host (local development).
# APP_BASE_URL=https://nodejs-nzeta.onrender.com
# console = the letter (code + link) is written to the log; no real email until there is a domain
MAILER=console
# false only for plain-http local development
COOKIE_SECURE=false
LOGIN_CODE_TTL_MINUTES=10

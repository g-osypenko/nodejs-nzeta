{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": ".",
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "customConditions": ["source"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*.ts", "packages/*/src/**/*", "packages/*/test/**/*", "vitest.config.ts", "vitest.mutation.config.ts"],
  "exclude": ["node_modules", "dist", "packages/*/dist", "coverage", "reports"]
}
